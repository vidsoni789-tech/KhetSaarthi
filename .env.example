# =====================================================================
# KhetSaarthi 🌱 — Environment Configuration Template
# =====================================================================
# ALL KEYS ARE 100% OPTIONAL. The app boots and functions fully without them.
# =====================================================================

# 1. Government AGMARKNET Mandi Feed (Optional)
# Register a free key at: https://data.gov.in/
# If left blank, KhetSaarthi uses verified historical APMC snapshots with real dates.
DATA_GOV_API_KEY=

# 2. Live Conversational LLM Engine (Optional)
# Enter any ONE of the following for free, high-speed multi-turn chat:
# - Groq (Recommended, ~300ms LLaMA 3.3 70B): https://console.groq.com/keys
# - Google Gemini (Gemini 2.5 Flash): https://aistudio.google.com/app/apikey
# - Hugging Face: https://huggingface.co/settings/tokens
# If left blank, KhetSaarthi uses its built-in Deterministic Grounded Engine.
GROQ_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# 3. Outbound WhatsApp API Push Gateway (Optional)
# For automated HTTP background dispatch to farmer phones:
# - Twilio: https://www.twilio.com/console
# - CallMeBot (Free personal WhatsApp webhook): https://www.callmebot.com/
# If left blank, KhetSaarthi uses the 1-Click WhatsApp Direct Launcher (no setup needed).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
CALLMEBOT_API_KEY=


